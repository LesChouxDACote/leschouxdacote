# Copier en .env : c'est ce fichier que lisent « yarn watch-trello » et les scripts ponctuels
# (ts-node -r dotenv/config). « next dev » lit en plus .env.local, que les scripts ignorent.

# --- Application Next.js (Vercel / Coolify) ---
ALGOLIA_ADMIN_KEY=xxxxxxxx

FIREBASE_EMAIL=firebase-adminsdk-xxxx@xxxxxxxx.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=XXXXXXXXXXXXXXXX=
INSEE_TOKEN=xxxxxxxx

MAILJET_PUBLIC_KEY=xxxxxxxx
MAILJET_PRIVATE_KEY=xxxxxxxx

NEXT_PUBLIC_ALGOLIA_APP_ID=XXXXXXXX
NEXT_PUBLIC_ALGOLIA_API_KEY=xxxxxxxx
NEXT_PUBLIC_ALGOLIA_INDEX=leschouxdacote
NEXT_PUBLIC_ALGOLIA_TAGS=tags
NEXT_PUBLIC_BUGSNAG=xxxxxxxx
NEXT_PUBLIC_FIREBASE_ID=1:XXXXXXXX:web:xxxxxxxx
NEXT_PUBLIC_FIREBASE_KEY=XXXXXXXX
NEXT_PUBLIC_FIREBASE_MEASURE=G-XXXXXXXX
NEXT_PUBLIC_FIREBASE_MESSAGING=XXXXXXXX
NEXT_PUBLIC_FIREBASE_PROJECT=xxxxxxxx
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxxxxxxx.xxxxxxxx
NEXT_PUBLIC_URL=https://leschouxdacote.fr

# --- Watcher Trello + IA (à saisir dans Coolify — voir README « Automatisation Trello + IA ») ---
# Seules les variables sans valeur par défaut sont listées ici : listes Trello, cadences,
# IA_BASE_BRANCH, IA_FIX_ATTEMPTS et IA_DEPLOY_TIMEOUT_MINUTES ont un défaut dans le
# docker-compose.yml, inutile de les recopier pour démarrer.

# clé/token via https://trello.com/power-ups/admin
TRELLO_API_KEY=xxxxxxxx
TRELLO_TOKEN=xxxxxxxx
TRELLO_BOARD_ID=xxxxxxxx

# token GitHub fine-grained (Contents + Pull requests en read/write) : push et création de PR
GH_TOKEN=xxxxxxxx
GITHUB_REPO=LesChouxDACote/leschouxdacote

# Accès aux modèles via le proxy LiteLLM. LITELLM_VIRTUAL_KEY est une clé virtuelle
# (/key/generate), pas la master key du proxy.
LITELLM_BASE_URL=http://192.168.1.101:4000
LITELLM_VIRTUAL_KEY=sk-xxxxxxxx
# étiquette Trello opus/sonnet/haiku → model_name LiteLLM ; IA_MODEL_DEFAULT = sans étiquette
IA_MODEL_OPUS=kimi-k3
IA_MODEL_SONNET=glm-5.3-flash
IA_MODEL_HAIKU=qwen3-30b-a3b-instruct
IA_MODEL_DEFAULT=sonnet

# Optionnel : lien du preview ajouté au commentaire Trello
PREVIEW_URL_TEMPLATE=https://{{pr_id}}.choux.ilieff.fr
# Optionnel, les trois ensemble : suivi des déploiements de preview + auto-correction
COOLIFY_API_URL=https://coolify.example.com
COOLIFY_API_TOKEN=xxxxxxxx
COOLIFY_APP_UUID=xxxxxxxx
