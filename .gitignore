# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# e2e (tests Playwright, paquet isolé)
/e2e/node_modules/
/e2e/test-results/
/e2e/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.idea

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files - uncomment the following line to ignore the configuration files
.env
.env.*
!e2e/.env.example

# vercel
.vercel

# lint
.eslintcache

# firebase
.firebaserc

# typescript cache
*.tsbuildinfoz

# yarn
.yarn/unplugged/
.yarn/install-state.gz

tsconfig.tsbuildinfo
