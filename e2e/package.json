{
  "name": "leschouxdacote-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Tests end-to-end Playwright (Trello #238). Paquet isolé : les dépendances de test ne touchent pas au yarn.lock de l'application.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "install-browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2"
  }
}
