# Identifiants des comptes de test fournis par le PO (environnement de développement).
# À recopier dans e2e/.env (ignoré par git). En CI, utiliser des secrets GitHub
# TEST_BUYER_EMAIL / TEST_BUYER_PASSWORD / TEST_PRODUCER_EMAIL / TEST_PRODUCER_PASSWORD.
# Optionnel : E2E_BASE_URL pour cibler un serveur distant (ex. https://develop.leschouxdacote.fr)
# au lieu du build local servi par `yarn serve`.
TEST_BUYER_EMAIL=
TEST_BUYER_PASSWORD=
TEST_PRODUCER_EMAIL=
TEST_PRODUCER_PASSWORD=
